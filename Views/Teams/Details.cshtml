@model SportsLeague.Models.Team

@{
    ViewData["Title"] = "Team Details";
}

<h1>Details</h1>

<div>
    <h4>Team</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">City</dt>
        <dd class="col-sm-10">@Model.City</dd>
        <dt class="col-sm-2">Players</dt>
        <dd class="col-sm-10">
            @if (Model.TeamPlayers != null && Model.TeamPlayers.Any())
            {
                <ul class="list-unstyled mb-0">
                @foreach (var tp in Model.TeamPlayers)
                {
                    if (tp.Player != null)
                    {
                        <li>
                            <a asp-controller="Players" asp-action="Details" asp-route-id="@tp.Player.Id">@tp.Player.FirstName @tp.Player.LastName</a>
                        </li>
                    }
                }
                </ul>
            }
            else
            {
                <em>No players</em>
            }
        </dd>
    </dl>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>
