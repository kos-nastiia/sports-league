@model SportsLeague.Models.Team

@{
    ViewData["Title"] = "Team Details";
    var currentUserName = User.Identity?.Name ?? string.Empty;
}

<h1>Details</h1>

<div>
    <h4>Team</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.Name</dd>

        <dt class="col-sm-2">City</dt>
        <dd class="col-sm-10">@Model.City</dd>
        <dt class="col-sm-2">Players</dt>
        <dd class="col-sm-10">
            @if (Model.TeamPlayers != null && Model.TeamPlayers.Any())
            {
                <ul class="list-unstyled mb-0">
                @foreach (var tp in Model.TeamPlayers)
                {
                    if (tp.Player != null)
                    {
                        <li>
                            <a asp-controller="Players" asp-action="Details" asp-route-id="@tp.Player.Id">@tp.Player.FirstName @tp.Player.LastName</a>
                        </li>
                    }
                }
                </ul>
            }
            else
            {
                <em>No players</em>
            }
        </dd>
    </dl>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>

<hr />
<h3>Team Chat</h3>
<div class="card mb-3">
    <div class="card-body">
        <div id="chatWindow" style="max-height: 400px; overflow-y: auto;">
            @{ var history = ViewBag.ChatHistory as List<SportsLeague.Models.ChatMessage> ?? new List<SportsLeague.Models.ChatMessage>(); }
            @foreach (var msg in history)
            {
                var showMessage = string.IsNullOrEmpty(msg.ReceiverName) || msg.SenderName == currentUserName || msg.ReceiverName == currentUserName;
                if (!showMessage)
                {
                    continue;
                }

                <div class="mb-2">
                    <strong>@msg.SenderName</strong>
                    <small class="text-muted">@msg.Timestamp.ToString("g")</small>
                    @if (!string.IsNullOrEmpty(msg.ReceiverName))
                    {
                        <div class="text-secondary small">
                            @if (msg.SenderName == currentUserName)
                            {
                                @($"Private to {msg.ReceiverName}")
                            }
                            else
                            {
                                @($"Private from {msg.SenderName}")
                            }
                        </div>
                    }
                        <div>@Html.Encode(msg.MessageText)</div>
                    @if (!string.IsNullOrEmpty(msg.FilePath))
                    {
                        var ext = System.IO.Path.GetExtension(msg.FilePath)?.TrimStart('.').ToLowerInvariant();
                        if (ext == "jpg" || ext == "jpeg" || ext == "png" || ext == "gif")
                        {
                            <div class="mt-1">
                                <a href="@msg.FilePath" target="_blank">
                                    <img src="@msg.FilePath" alt="attachment" style="max-width:200px; max-height:200px;" />
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="mt-1">
                                <a href="@msg.FilePath" target="_blank">Download Attachment File</a>
                            </div>
                        }
                    }
                </div>
            }
        </div>

        <div class="mt-3">
            <div class="row gx-2 mb-2">
                <div class="col-auto d-flex align-items-center">
                    <label for="recipientInput" class="form-label mb-0">Send to:</label>
                </div>
                <div class="col">
                    <input id="recipientInput" list="recipientList" class="form-control" placeholder="Everyone" />
                    <datalist id="recipientList">
                        @foreach (var tp in Model.TeamPlayers ?? Enumerable.Empty<SportsLeague.Models.TeamPlayer>())
                        {
                            if (tp.Player != null)
                            {
                                <option value="@tp.Player.FirstName @tp.Player.LastName"></option>
                            }
                        }
                    </datalist>
                </div>
            </div>
            <div class="input-group">
                <input id="messageInput" type="text" class="form-control" placeholder="Type a message..." />
                <input id="fileInput" type="file" class="form-control" style="max-width:200px;" />
                <button id="sendBtn" class="btn btn-primary">Send</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/lib/signalr/dist/browser/signalr.min.js"></script>
    <script>
        (function () {
            const teamId = '@Model.Id';
            const chatWindow = document.getElementById('chatWindow');
            const messageInput = document.getElementById('messageInput');
            const recipientInput = document.getElementById('recipientInput');
            const fileInput = document.getElementById('fileInput');
            const sendBtn = document.getElementById('sendBtn');
            const currentUserName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(User.Identity?.Name ?? string.Empty));

            function appendMessage(sender, text, filePath, timestamp, receiverName) {
                if (receiverName && receiverName !== currentUserName && sender !== currentUserName) {
                    return;
                }

                const div = document.createElement('div');
                div.className = 'mb-2';
                const header = document.createElement('div');
                const strong = document.createElement('strong');
                strong.textContent = sender;
                const small = document.createElement('small');
                small.className = 'text-muted ms-2';
                small.textContent = ' ' + timestamp;
                header.appendChild(strong);
                header.appendChild(small);
                div.appendChild(header);

                if (receiverName) {
                    const privateTag = document.createElement('div');
                    privateTag.className = 'text-secondary small';
                    privateTag.textContent = sender === currentUserName
                        ? 'Private to ' + receiverName
                        : 'Private from ' + sender;
                    div.appendChild(privateTag);
                }

                const msgDiv = document.createElement('div');
                msgDiv.textContent = text;
                div.appendChild(msgDiv);

                if (filePath) {
                    const wrap = document.createElement('div');
                    wrap.className = 'mt-1';
                    const ext = filePath.split('.').pop()?.toLowerCase();
                    if (ext === 'jpg' || ext === 'jpeg' || ext === 'png' || ext === 'gif') {
                        const img = document.createElement('img');
                        img.src = filePath;
                        img.alt = 'attachment';
                        img.style.maxWidth = '200px';
                        img.style.maxHeight = '200px';
                        wrap.appendChild(img);
                        } else {
                        const a = document.createElement('a');
                        a.href = filePath;
                        a.target = '_blank';
                        a.textContent = 'Download Attachment File';
                        wrap.appendChild(a);
                    }
                    div.appendChild(wrap);
                }

                chatWindow.appendChild(div);
                chatWindow.scrollTop = chatWindow.scrollHeight;
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl('/chatHub')
                .withAutomaticReconnect()
                .build();

            connection.start().then(function () {
                connection.invoke('JoinTeamChat', teamId).catch(console.error);
            }).catch(function (err) {
                console.error(err.toString());
            });

            connection.on('ReceiveMessage', function (sender, message, filePath, timestamp, receiverName) {
                appendMessage(sender, message, filePath, timestamp, receiverName);
            });

            sendBtn.addEventListener('click', async function () {
                const text = messageInput.value || '';
                const recipient = recipientInput.value?.trim() || '';
                let uploadedPath = '';
                if (fileInput.files && fileInput.files.length > 0) {
                    const fd = new FormData();
                    fd.append('file', fileInput.files[0]);
                    try {
                        const resp = await fetch('/Teams/UploadChatFile', { method: 'POST', body: fd });
                        if (!resp.ok) throw new Error('Upload failed');
                        const data = await resp.json();
                        uploadedPath = data.filePath || '';
                    } catch (e) {
                        console.error(e);
                        alert('File upload failed.');
                        return;
                    }
                }

                try {
                    if (recipient && recipient.toLowerCase() !== 'everyone') {
                        await connection.invoke('SendPrivateMessageToUser', teamId.toString(), recipient, text, uploadedPath);
                    } else {
                        await connection.invoke('SendMessageToTeam', teamId.toString(), text, uploadedPath);
                    }
                    messageInput.value = '';
                    fileInput.value = '';
                } catch (err) {
                    console.error(err.toString());
                }
            });
        })();
    </script>
}
