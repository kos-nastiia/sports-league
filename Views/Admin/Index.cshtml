@model IEnumerable<Microsoft.AspNetCore.Identity.IdentityUser>

@{
    ViewData["Title"] = "Admin Panel";
}

<h1>Admin Panel</h1>
<p class="mb-4">Manage registered users in the Sports League application.</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>User ID</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.Email</td>
                <td>
                    @if (!string.Equals(user.Email, "admin@league.com", System.StringComparison.OrdinalIgnoreCase))
                    {
                        <form asp-action="DeleteUser" method="post" onsubmit="return confirm('Are you sure you want to delete user ' + '@user.Email' + '?');" class="d-inline">
                            <input type="hidden" name="id" value="@user.Id" />
                            <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                        </form>
                    }
                    else
                    {
                        <span class="text-muted">Protected</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
