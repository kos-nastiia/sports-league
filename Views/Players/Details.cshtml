@model SportsLeague.Models.Player

@{
    ViewData["Title"] = "Player Details";
}

<h1>Details</h1>

<div>
    <h4>Player</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">@Model.FirstName @Model.LastName</dd>

        <dt class="col-sm-2">Position</dt>
        <dd class="col-sm-10">@Model.Position</dd>

        <dt class="col-sm-2">Number</dt>
        <dd class="col-sm-10">@Model.Number</dd>

        <dt class="col-sm-2">Teams</dt>
        <dd class="col-sm-10">
            @if (Model.TeamPlayers != null && Model.TeamPlayers.Any())
            {
                foreach (var tp in Model.TeamPlayers)
                {
                    <div>
                        @tp.Team.Name 
                        (@tp.StartDate.ToShortDateString()
                        -
                        @(tp.EndDate?.ToShortDateString() ?? "Present"))
                    </div>
                }
            }
            else
            {
                <span>No teams</span>
            }
        </dd>
    </dl>
</div>

<p>
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Edit</a> |
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</p>
