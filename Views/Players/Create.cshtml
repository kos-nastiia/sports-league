@model SportsLeague.Models.Player

@{
    ViewData["Title"] = "Create Player";
}

<h1>Create Player</h1>

<form asp-action="Create">
    
    <div class="form-group">
        <label asp-for="FirstName"></label>
        <input asp-for="FirstName" class="form-control" />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="LastName"></label>
        <input asp-for="LastName" class="form-control" />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="BirthDate"></label>
        <input asp-for="BirthDate" type="date" class="form-control" />
        <span asp-validation-for="BirthDate" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="Position"></label>
        <input asp-for="Position" class="form-control" />
        <span asp-validation-for="Position" class="text-danger"></span>
    </div>

    <div class="form-group mt-2">
        <label asp-for="Number"></label>
        <input asp-for="Number" class="form-control" />
        <span asp-validation-for="Number" class="text-danger"></span>
    </div>
    <div class="form-group mt-2">
        <label>Team</label>
        <select name="teamId" class="form-control">
            <option value="">-- Select Team --</option>
            @foreach (var team in ViewBag.Teams)
            {
                <option value="@team.Id">@team.Name (@team.City)</option>
            }
        </select>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Create</button>
        <button type="button" id="savePlayerDraftBtn" class="btn btn-outline-secondary ms-2">Save Draft</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </div>

</form>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        const PLAYER_DRAFT_KEY = 'playerDraft';

        function getPlayerForm() {
            return {
                FirstName: document.querySelector('[name="FirstName"]').value,
                LastName: document.querySelector('[name="LastName"]').value,
                BirthDate: document.querySelector('[name="BirthDate"]').value,
                Position: document.querySelector('[name="Position"]').value,
                Number: document.querySelector('[name="Number"]').value,
                teamId: (document.querySelector('[name="teamId"]') ? document.querySelector('[name="teamId"]').value : '')
            };
        }

        function populatePlayerForm(d) {
            if (!d) return;
            if (d.FirstName) document.querySelector('[name="FirstName"]').value = d.FirstName;
            if (d.LastName) document.querySelector('[name="LastName"]').value = d.LastName;
            if (d.BirthDate) document.querySelector('[name="BirthDate"]').value = d.BirthDate;
            if (d.Position) document.querySelector('[name="Position"]').value = d.Position;
            if (d.Number) document.querySelector('[name="Number"]').value = d.Number;
            if (d.teamId && document.querySelector('[name="teamId"]')) document.querySelector('[name="teamId"]').value = d.teamId;
        }

        document.getElementById('savePlayerDraftBtn').addEventListener('click', function () {
            const data = getPlayerForm();
            const key = 'playerDrafts';
            const existing = sessionStorage.getItem(key);
            let arr = [];
            try { arr = existing ? JSON.parse(existing) : []; } catch { arr = []; }
            arr.push(data);
            sessionStorage.setItem(key, JSON.stringify(arr));
            window.location.href = '/Players';
        });

        document.addEventListener('DOMContentLoaded', function () {
            const raw = sessionStorage.getItem(PLAYER_DRAFT_KEY);
            if (raw) {
                try { populatePlayerForm(JSON.parse(raw)); } catch { }
            }
        });
    </script>
}
