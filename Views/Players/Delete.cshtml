@model SportsLeague.Models.Player

@{
    ViewData["Title"] = "Delete Player";
}

<h1>Delete Player</h1>

<h3>Are you sure you want to delete this?</h3>

<div>
    <dl class="row">
        
        <dt class="col-sm-2">Name</dt>
        <dd class="col-sm-10">
            @Model.FirstName @Model.LastName
        </dd>

        <dt class="col-sm-2">Position</dt>
        <dd class="col-sm-10">
            @Model.Position
        </dd>

        <dt class="col-sm-2">Number</dt>
        <dd class="col-sm-10">
            @Model.Number
        </dd>

        <dt class="col-sm-2">Teams</dt>
        <dd class="col-sm-10">
            @if (Model.TeamPlayers != null && Model.TeamPlayers.Any())
            {
                foreach (var tp in Model.TeamPlayers)
                {
                    <div>
                        @tp.Team.Name 
                        (@tp.StartDate.ToShortDateString()
                        -
                        @(tp.EndDate?.ToShortDateString() ?? "Present"))
                    </div>
                }
            }
            else
            {
                <span>No teams</span>
            }
        </dd>

    </dl>
</div>

<form asp-action="Delete">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
